# DealMind AI frontend configuration (copy to .env.local and adjust)

# FastAPI backend base URL. Leave empty ("") to use relative /api requests through the Vite dev proxy.
VITE_API_BASE_URL=http://localhost:8000

# Data mode:
#   auto  -> use the live API when GET /api/health responds, otherwise fall back to bundled mock data
#   false -> Live API only (no mock fallback)
#   true  -> Mock data only (offline preview)
VITE_USE_MOCK=auto

# Optional: target for the Vite dev proxy when VITE_API_BASE_URL is empty
# VITE_API_PROXY_TARGET=http://localhost:8000

# Optional: try future /api/reports/* endpoints before using bundled report JSON (default off)
# VITE_ENABLE_REPORT_ENDPOINTS=false
